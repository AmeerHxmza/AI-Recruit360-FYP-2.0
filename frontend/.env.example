NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
AI_SERVICE_URL=http://127.0.0.1:8000/api/v1
# Generate strong random values, at least 32 characters. Never commit actual secrets.
# AI_SERVICE_SHARED_SECRET must match ai-service/.env.
AI_SERVICE_SHARED_SECRET=
CANDIDATE_SESSION_SECRET=

# Server-only avatar credentials. Never use NEXT_PUBLIC_ for the API key.
SIMLI_API_KEY=
SIMLI_FACE_ID=
