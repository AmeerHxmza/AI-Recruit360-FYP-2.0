# AI-Recruit360 - Frontend Environment Variables

# Next.js Application URL
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Supabase Public Keys (Safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...your-anon-key...

# AI Service URL
# Used by Next.js Server Actions to securely communicate with the Python backend
NEXT_PUBLIC_AI_SERVICE_URL=https://ai-recruit360-fyp.onrender.com/api/v1
# Used to authenticate Server Actions to the Python backend
AI_SERVICE_SECRET=recruit360_shared_backend_secret_2026
