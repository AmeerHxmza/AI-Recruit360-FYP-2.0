ENVIRONMENT=development
AI_SERVICE_PORT=8000
WORKER_COUNT=1
ALLOWED_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
AI_SERVICE_SHARED_SECRET=
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
CV_PASS_THRESHOLD=70
ASSESSMENT_PASS_THRESHOLD=60
# Optional alternative provider: set AI_PROVIDER=gemini and configure an enabled model.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Interviewer voice (independent of the Simli face ID)
OPENAI_TTS_VOICE=nova
